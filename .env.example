# Server / Database
VITE_API_BASE=http://localhost:8000
CENTRIX_DB_PATH=/app/data/centrix.db

# xKiro AI Configuration (Backend Only - NEVER expose to frontend or clients)
XKIRO_API_KEY=your_key_here
AI_PROVIDER=xkiro
AI_BASE_URL=https://api.xkiro.com/v1

# Free Models Only
AI_PRIMARY_MODEL=minimax/minimax-m3:free
AI_CODING_MODEL=qwen/qwen3-coder-plus:free
AI_VISION_MODEL=qwen/qwen3-vl-plus:free
AI_FAST_MODEL=qwen/qwen3.5-flash:free

# Agent Execution & Safety Limits
AI_MAX_STEPS=100
AI_REQUEST_TIMEOUT=120
AI_REQUIRE_APPROVAL_FOR_ACTIVE_TESTS=true
AI_MAX_REQUESTS_PER_SCAN=500
AI_MAX_CONCURRENT_REQUESTS=5
